&AtClient
Procedure Cancel(Command)
	CurrentData = Items.List.CurrentData;
		If CurrentData <> Undefined Then
		Document = CurrentData.Document;
		Description = CurrentData.Description;
		
		WorkWithLessonsServer.SetLessonStatusCanceled(Document, Description);
		Items.List.Refresh();	
		SetCancelCommandEnabled(Items.List.CurrentData.State);
	EndIf;
EndProcedure

&AtClient
Procedure ListSelection(Item, RowSelected, Field, StandardProcessing)
	LessonCreationRequestDocument = Item.CurrentData.Document; 
	
	FormParameters = New Structure("Key", LessonCreationRequestDocument); 
	CallbackDescription = New CallbackDescription("LessonCreationRequestDocumentOnCompletion", ThisObject );
	OpenForm("Document.LessonCreationRequest.ObjectForm", FormParameters,,,,, CallbackDescription);
	
EndProcedure

&AtClient
Procedure LessonCreationRequestDocumentOnCompletion(ExecutionResult, AdditionalParameters) Export	
	
	Items.List.Refresh();
	SetChangeStatusCommandTitle(Items.List.CurrentData.State)
	
EndProcedure

&AtServer
Procedure ChangeStatusAtServer(Document, Description, OpenLessonForm, OpenEmployeesForm)
	
	LessonCreationRequestDocument = Document.GetObject();
	If LessonCreationRequestDocument.RequestType = Enums.LessonRequestTypes.Curriculum Then
		//RequestType = Curriculum	
		LessonRow = LessonCreationRequestDocument.Lessons.Find(Description, "Description");	
	Else //RequestType = Single lesson
		LessonRow = LessonCreationRequestDocument.Lessons.Get(0);
	EndIf;
		CurrentStatus = LessonRow.State;
	
	If CurrentStatus = Enums.LessonCreationStates.Started Then	
		OpenLessonForm = True;
	ElsIf CurrentStatus = Enums.LessonCreationStates.Planned Then
		OpenEmployeesForm = True;
	EndIf;
		
EndProcedure

&AtClient
Procedure ChangeStatus(Command)
	CurrentData = Items.List.CurrentData;
	If CurrentData <> Undefined Then
		Document = CurrentData.Document;
		Description = CurrentData.Description;
		OpenLessonForm = False;
		OpenEmployeesForm = False;
		
		ChangeStatusAtServer(Document, Description, OpenLessonForm, OpenEmployeesForm);
		
		FillingValues = New Structure;
		FillingValues.Insert("Description", Description);
		FillingValues.Insert("Format", CurrentData.Format);
		
		FormParameters = New Structure("FillingValues", FillingValues);
		
		SelectEmployeeCallbackDescription = New CallbackDescription("AfterSelectEmployee", ThisObject );
		If OpenLessonForm Then		
			OpenForm("Catalog.Lessons.ObjectForm", FormParameters); 
		ElsIf OpenEmployeesForm Then
			OpenForm("Catalog.Employees.ChoiceForm",,,,,, SelectEmployeeCallbackDescription);
		Else
			SetNextStatus(Document, Description);
			Items.List.Refresh();
			SetChangeStatusCommandTitle(Items.List.CurrentData.State);		
		EndIf; 
	EndIf;	
EndProcedure 


&AtClient
Procedure NotificationProcessing(EventName, Parameter, Source)
	
	If EventName = "LessonAfterWrite" Then
		CurrentData = Items.List.CurrentData;
		Document = CurrentData.Document;
		Description = CurrentData.Description; 
			
		AttributesToUpdate = New Map;
		AttributesToUpdate.Insert("Attribute", "NewLesson");
		AttributesToUpdate.Insert("NewLesson", Parameter.Ref);
			
		SetNextStatus(Document, Description, AttributesToUpdate);
		Items.List.Refresh();
		SetChangeStatusCommandTitle(Items.List.CurrentData.State);			
	EndIf;
	
EndProcedure

&AtClient
 Procedure AfterSelectEmployee(SelectedValue, AdditionalParameters) Export
	
	CurrentData = Items.List.CurrentData;
	Document = CurrentData.Document;
	Description = CurrentData.Description; 
	
	If SelectedValue <> Undefined Then		
		//ChangeLessonRequestStatus(Document, Description);
		//UpdateResponsibleInRequest(Document, Description, SelectedValue);
		AttributesToUpdate = New Map;
		AttributesToUpdate.Insert("Attribute", "Responsible");
		AttributesToUpdate.Insert("Responsible", SelectedValue);
		
		SetNextStatus(Document, Description, AttributesToUpdate);
		Items.List.Refresh();
		SetChangeStatusCommandTitle(Items.List.CurrentData.State);			
	EndIf;
	
EndProcedure 


&AtClient
Procedure ListOnActivateRow(Item)
	CurrentData = Item.CurrentData;
	If CurrentData = Undefined Then
		Return;
	EndIf;	
	CurrentStatus = CurrentData.State;
	
	SetChangeStatusCommandTitle(CurrentStatus);
	SetCancelCommandEnabled(CurrentStatus);
	
EndProcedure

&AtClient
Procedure SetChangeStatusCommandTitle(CurrentStatus)
	
	NextStatus = WorkWithLessonsClientServer.NextStatus(CurrentStatus);
	
	Items.ListChangeStatus.Title = WorkWithLessonsClientServer.ActionNamesByStatuses().Get(NextStatus);
	SetChangeStatusCommandEnabled(CurrentStatus);	
	SetCancelCommandEnabled(CurrentStatus);
	
EndProcedure

&AtClient
Procedure SetChangeStatusCommandEnabled(LessonStatus)
	
	If LessonStatus = PredefinedValue("Enum.LessonCreationStates.Finished") 
		OR LessonStatus = PredefinedValue("Enum.LessonCreationStates.Cancelled") Then
		Items.ListChangeStatus.Enabled = False;
	Else
		Items.ListChangeStatus.Enabled = True;
	EndIf;	
	
EndProcedure

&AtClient
Procedure SetCancelCommandEnabled(LessonStatus)
	
	If LessonStatus = PredefinedValue("Enum.LessonCreationStates.Finished") 
		OR LessonStatus = PredefinedValue("Enum.LessonCreationStates.Cancelled") Then
		Items.ListCancel.Enabled = False;
	Else
		Items.ListCancel.Enabled = True;
	EndIf;	
	
EndProcedure

&AtServer
Procedure SetNextStatus(Document, Description, AttributesToUpdate = Undefined)

	Documents.LessonCreationRequest.SetNextStatus(Document, Description, AttributesToUpdate);
	
EndProcedure



Procedure Filling(FillingData, StandardProcessing)
	
	FillingData = GetFillingData(FillingData.Ref);
	For Each CurRow In FillingData Do		
		Format = CurRow.Format;
		Basis = CurRow.Ref;
		Type = CurRow.Type;
		NewRow = Content.Add(); 
		If CurRow.NewLesson <> Catalogs.Lessons.EmptyRef() Then
			NewRow.Lesson = CurRow.NewLesson;
		Else
			NewRow.Lesson = CurRow.ExistingLesson;
		EndIf;
		NewRow.PracticalDuration = CurRow.PracticeDuration;
		NewRow.TheoryDuration = CurRow.TheoryDuration;
	EndDo;


EndProcedure

Function GetFillingData(CreatingCurriculum)
	Result = New Structure;
	ResultSets = New Array; 
	// We always get data of only 1 document
	Query = New Query;
	Query.Text = 
	"SELECT
	|	CreatingCurriculum.Ref AS Ref,
	|	CreatingCurriculum.Format AS Format,
	|	CreatingCurriculum.Type AS Type,
	|	CreatingCurriculumLessons.Description AS Description,
	|	CreatingCurriculumLessons.TheoryDuration AS TheoryDuration,
	|	CreatingCurriculumLessons.PracticeDuration AS PracticeDuration,
	|	CreatingCurriculumLessons.ExistingLesson AS ExistingLesson,
	|	CreatingCurriculumLessons.NewLesson AS NewLesson
	|FROM
	|	Document.CreatingCurriculum.Lessons AS CreatingCurriculumLessons
	|		LEFT JOIN Document.CreatingCurriculum AS CreatingCurriculum
	|		ON CreatingCurriculumLessons.Ref = CreatingCurriculum.Ref
	|WHERE
	|	CreatingCurriculum.Ref = &Ref";
	
	Query.SetParameter("Ref", CreatingCurriculum);
	
	QueryResult = Query.Execute();   
	VT = QueryResult.Unload();

	
	Selection = QueryResult.Select();
	
	While Selection.Next() Do 
		For Each Column In QueryResult.Columns Do
		    Result.Insert(Column.Name);
		EndDo;
	    FillPropertyValues(Result, Selection);
		
		ResultSets.Add(Result); 
		Result = New Structure;
	EndDo;
	
	Return ResultSets;

EndFunction

